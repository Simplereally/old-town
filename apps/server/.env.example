# Old Town server environment.
# Copy to .env for local overrides.

# Port the WebSocket server listens on.
PORT=8080

# Server simulation tick length in milliseconds (gameplay truth; do not change lightly).
TICK_MS=600

# Local diagnostics.
DEBUG=false
LOG_JSON=false

# Content directory path relative to the repo root when using `bun run dev`.
CONTENT_DIR=content

# Persistence subsystem.
# Driver: postgres (default local/dev/prod) | memory (tests) | json_file (deprecated) | disabled.
PERSISTENCE_DRIVER=postgres
# PostgreSQL connection. Matches docker-compose.yml; start it with `bun run db:up && bun run db:migrate`.
DATABASE_URL=postgres://old_town:old_town@localhost:5432/old_town
# Logical world id stamped onto saves / session leases, and the content build version for saves.
WORLD_ID=old_town_dev
CONTENT_VERSION=1
# Enforce one-live-owner-per-character session leasing on connect.
PERSISTENCE_SESSION_LEASING=false
# How often lazily-dirty characters (position/hp/skilling) are coalesced and flushed.
PERSISTENCE_LAZY_SAVE_TICKS=10
# Deprecated JSON-file path, used only when PERSISTENCE_DRIVER=json_file (debug export / sandbox).
PERSISTENCE_FILE=.old-town/dev-persistence.json
# Legacy toggle (still honoured when PERSISTENCE_DRIVER is unset): false -> disabled, true -> json_file.
# PERSISTENCE_ENABLED=false

# PostgreSQL pool / query / lock timeouts (env-configurable; see pg-sql-client.ts).
# Max pooled connections.
PG_MAX_CONNECTIONS=10
# Pool connect timeout in ms.
PG_CONNECTION_TIMEOUT_MS=2000
# Pool idle connection timeout in ms.
PG_IDLE_TIMEOUT_MS=30000
# Per-query statement_timeout in ms — a slow query surfaces as a persistence error, not a hung slot.
PG_STATEMENT_TIMEOUT_MS=5000
# Row lock timeout in ms — a stuck lock surfaces as a persistence error, not a hung slot.
PG_LOCK_TIMEOUT_MS=1000
# idle_in_transaction_session_timeout in ms — prevents leaked open transactions from holding locks.
PG_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=5000
