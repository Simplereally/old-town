{
  "id": "baker_dialogue",
  "name": "Baker Dialogue",
  "root": "start",
  "nodes": [
    {
      "id": "start",
      "npcText": "If you're here for bread, you'll have to help me get the oven breathing first.",
      "playerOptions": [
        {
          "text": "What happened to the oven?",
          "next": "oven_trouble",
          "requirements": [
            { "kind": "var", "key": "quest.smoke_over_old_town.stage", "op": "eq", "value": 0 }
          ]
        },
        {
          "text": "I'm still working on it.",
          "next": "in_progress",
          "requirements": [
            { "kind": "var", "key": "quest.smoke_over_old_town.stage", "op": "gte", "value": 10 },
            {
              "kind": "var",
              "key": "quest.smoke_over_old_town.completed",
              "op": "neq",
              "value": true
            }
          ]
        },
        {
          "text": "The oven's breathing again.",
          "next": "completed",
          "requirements": [
            {
              "kind": "var",
              "key": "quest.smoke_over_old_town.completed",
              "op": "eq",
              "value": true
            }
          ]
        },
        { "text": "I should go.", "next": "end" }
      ]
    },
    {
      "id": "oven_trouble",
      "npcText": "Smoke in the flue, rats in the cellar, and not enough dry wood to restart it cleanly.",
      "playerOptions": [
        {
          "text": "I'll sort it out.",
          "next": "accepted",
          "effects": [
            { "kind": "start_quest", "questId": "smoke_over_old_town" },
            { "kind": "add_item", "itemId": "smoke_over_old_town_baker_oven_key", "quantity": 1 },
            { "kind": "send_message", "text": "Quest started: Smoke Over Old Town." }
          ]
        },
        { "text": "Sounds like a bakery problem.", "next": "end" }
      ]
    },
    {
      "id": "accepted",
      "npcText": "Bring me three dry logs, clear out the cellar rats, then use this key on the oven.",
      "playerOptions": [{ "text": "I'll be back.", "next": "end" }]
    },
    {
      "id": "in_progress",
      "npcText": "Three dry logs, two fewer cellar rats, then light the Smoking Oven. Keep the key safe until then.",
      "playerOptions": [{ "text": "Back to work.", "next": "end" }]
    },
    {
      "id": "completed",
      "npcText": "The oven is drawing clean, the bread is rising, and Old Town can breathe again.",
      "playerOptions": [{ "text": "Glad to help.", "next": "end" }]
    },
    {
      "id": "end",
      "npcText": "Mind the smoke. It gets into everything."
    }
  ]
}
