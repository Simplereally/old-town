{
  "name": "old-town",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.9",
  "description": "Old Town \u2014 browser-first lo-fi 3D MMO inspired by 2006/2007 OSRS-era primitives.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "fix": "biome check --write .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:heavy": "vitest run --project heavy",
    "test:all": "vitest run",
    "test:no-sleeps": "bun scripts/assert-no-sleeps.ts",
    "test:postgres": "bun scripts/test-postgres.ts",
    "test:coverage": "vitest run --coverage",
    "dev": "bun scripts/dev.ts",
    "dev:persist": "bun scripts/dev.ts --persist",
    "dev:nosave": "bun scripts/dev.ts --nosave",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "db:migrate": "bun scripts/db-migrate.ts up",
    "db:rollback": "bun scripts/db-migrate.ts down",
    "stress:sim": "bun scripts/stress-sim.ts",
    "stress:render": "bun scripts/render-stress-report.ts",
    "stress:render:ci": "bun scripts/render-stress-report.ts --ci",
    "tasks:status": "bun scripts/tasks-status.ts",
    "tasks:check": "bun scripts/tasks-check.ts",
    "client:dev": "bun run --filter @old-town/client dev",
    "world-editor:dev": "bun run --filter @old-town/world-editor dev",
    "render:boundaries": "bun scripts/assert-render-boundaries.ts",
    "content:validate": "bun tools/content-validator/src/index.ts",
    "content:list": "bun tools/content-validator/src/index.ts list",
    "content:graph": "bun tools/content-validator/src/index.ts graph",
    "items:build-assets": "bun scripts/build-item-assets.ts",
    "items:validate-assets": "bun scripts/validate-item-assets.ts",
    "icons:render": "bun scripts/generate-item-icons.sh",
    "icons:pack-png": "bun scripts/pack-icon-png-atlas.ts",
    "icons:build": "bun scripts/generate-item-icons.sh && bun scripts/pack-icon-png-atlas.ts",
    "weapons:generate": "bun scripts/generate-weapon-models.sh",
    "weapons:copy": "bun scripts/copy-weapon-models.ts",
    "weapons:build": "bun scripts/generate-weapon-models.sh && bun scripts/copy-weapon-models.ts",
    "buildings:generate": "bash scripts/generate-building-models.sh",
    "buildings:copy": "bun scripts/copy-building-models.ts",
    "buildings:build": "bash scripts/generate-building-models.sh && bun scripts/copy-building-models.ts",
    "clean": "bun run --filter '*' clean || true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^3.2.0",
    "bun-types": "^1.3.14",
    "jsdom": "^29.1.1",
    "oh-my-opencode": "^4.5.12",
    "pg": "^8.13.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
