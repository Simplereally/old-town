{
  "name": "old-town",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Old Town — browser-first lo-fi 3D MMO inspired by 2006/2007 OSRS-era primitives.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev": "bun scripts/dev.ts",
    "stress:sim": "bun scripts/stress-sim.ts",
    "tasks:status": "bun scripts/tasks-status.ts",
    "client:dev": "bun run --filter @old-town/client dev",
    "world-editor:dev": "bun run --filter @old-town/world-editor dev",
    "content:validate": "bun tools/content-validator/src/index.ts",
    "content:list": "bun tools/content-validator/src/index.ts list",
    "content:graph": "bun tools/content-validator/src/index.ts graph",
    "clean": "bun run --filter '*' clean || true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.0",
    "bun-types": "^1.3.14",
    "typescript": "^5.7.3",
    "vitest": "^3.2.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "oh-my-opencode": "^4.5.12"
  }
}
